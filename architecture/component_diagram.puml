@startuml component_diagram

<style>
componentDiagram {
  component {
    BackgroundColor #f8f9fa
    LineColor #343a40
    RoundCorner 5
    FontColor #212529
  }
  package {
    BackgroundColor #ffffff
    LineColor #adb5bd
    LineStyle 1
    RoundCorner 5
  }
  cloud {
    BackgroundColor #e3f2fd
    LineColor #1565c0
  }
  database {
    BackgroundColor #fff3e0
    LineColor #ef6c00
  }
  arrow {
    LineColor #495057
    FontColor #495057
  }
  note {
    BackgroundColor #fff9c4
    LineColor #fbc02d
  }
}
</style>

title Compareror — Component Diagram\n(current state)

package "Entry Point" {
    [main.py] as Main
}

package "Presentation Layer (ui/)" {
    component "MainWindow" as MW
    component "LazyDirectoryTreeWidget" as LazyTree
    component "ThemeManager" as TM
    component "AppThemeProvider" as ThemeProvider

    package "Dialogs" {
        [SettingsDialog]
        [HelpDialog]
        [AboutDialog]
        [ReportDialog]
    }

    package "Workers (QThread)" {
        [CompareWorkerThread] as CW
        [SyncWorkerThread] as SW
        [CancelWorkerThread] as XW
    }

    note right of LazyTree
      Runtime UI uses LazyDirectoryTreeWidget.
      Retired modules `ui/directory_tree_widget.py`
      and `ui/styles.py` are placeholders only
      and are not part of active dependencies.
    end note
}

package "Domain Layer (sync/)" {
    component "DirectorySyncModel" as DSM
    note right of DSM
      **Facade / Coordinator**
      Manages state, caching,
      and strategy orchestration
    end note

    component "StrategyRegistry<T>" as Registry
    component "bootstrap" as Boot

    package "Core Interfaces (interfaces.py)" {
        [Protocols] as Proto
        [DataClasses] as DC
    }

    package "Utilities (utils.py)" {
        [ThrottledProgressCallback]
        [StopChecker]
        [BatchProcessor]
    }
}

package "Infrastructure / Strategies (strategies.py)" {
    component "DefaultDirectoryScanner" as Scanner
    component "DefaultHashProvider" as Hash
    component "CachingHashProvider" as CHash
    component "FullHashDiffStrategy" as DiffFull
    component "TwoPhaseDiffStrategy" as Diff2P
    component "FastDiffStrategy" as DiffFast
    component "DefaultSyncExecutor" as Executor

    note bottom of Executor
      Parallel execution via
      multiprocessing Pool
    end note
}

package "Configuration (app_settings.py)" {
    [AppSettings] as AS
    [SettingsManager] as SM
    [RegexRule / CompiledRegexRule] as Rules
}

package "Diagnostics" {
    [sync_debug.log] as DLog
}

database "settings.yaml" as YAML
database "FileSystem" as FS

cloud "External Libraries" {
    [PyQt6 >=6.6]
    [PyYAML >=6.0]
}

' === Entry Point ===
Main --> Boot : ensure_strategies_registered()
Main --> TM : set_provider(AppThemeProvider)
Main --> MW : create & show

' === UI Layer ===
MW *-- LazyTree : contains (x2: source & target)
MW --> SettingsDialog : opens
MW --> HelpDialog : opens
MW --> AboutDialog : opens
MW --> ReportDialog : opens (live stats)
MW --> TM : apply_theme()
MW --> AS : read config
MW *-- CW
MW *-- SW
MW *-- XW

CW --> DSM : compare_directories()
SW --> DSM : synchronize()
XW --> DSM : rollback_changes()

TM --> ThemeProvider : build_stylesheet / build_palette

' === Domain Layer ===
DSM --> Registry : lazy strategy lookup
MW --> DSM : set_filters() / set_diff_mode()
DSM --> Rules : apply regex filtering
Boot --> Registry : register defaults once

Registry ..> Scanner : provides
Registry ..> Hash : provides
Registry ..> CHash : provides (default)
Registry ..> DiffFull : provides ("strict")
Registry ..> Diff2P : provides ("two-phase")
Registry ..> DiffFast : provides ("fast")
Registry ..> Executor : provides

CHash o--> Hash : decorates

' === Infrastructure ===
Scanner --> FS : os.scandir (recursive)
Hash --> FS : read + MD5
Executor --> FS : copy / backup / rollback
Executor ..> DLog : writes if debug_logging=True

' === Configuration ===
SM --> AS : creates from YAML
SM --> YAML : reads / writes
AS *-- Rules : contains

@enduml
