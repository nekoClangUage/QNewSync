@startuml sequence_sync

<style>
sequenceDiagram {
    participant {
        BackgroundColor #f8f9fa
        LineColor #343a40
        RoundCorner 10
    }
    actor {
        BackgroundColor #e3f2fd
        LineColor #1565c0
    }
    database {
