title Compareror — UI Layer Architecture\n(current state)

package "PyQt6 Infrastructure" <<qt>> {
    class QMainWindow <<qt>>
    class QDialog <<qt>>
    class QThread <<qt>>
    class QTreeView <<qt>>
    class QFileSystemModel <<qt>>
    class QSortFilterProxyModel <<qt>>
}

package "Main Window" {
    class MainWindow {
        -model: DirectorySyncModel
        -settings_manager: SettingsManager
        -settings: AppSettings
        -compiled_rules: list[CompiledRegexRule]
        -tree1: LazyDirectoryTreeWidget
        -tree2: LazyDirectoryTreeWidget
        -report_dialog: ReportDialog | None
        -cancel_requested: bool
        --
        +setup_ui()
        +load_settings()
        +apply_settings(settings)
        +compare_directories()
        +start_synchronization()
        +stop_synchronization()
        +cancel_synchronization()
        +load_trees()
        +show_report()
        +open_settings()
        +show_help()
        +show_about()
        -_apply_settings_state()
        -_apply_tree_settings()
        -_start_cancel_thread()
        -_on_file_double_clicked(path)
    }

    class ClickableLineEdit {
        +clicked: pyqtSignal
        +mousePressEvent()
    }

    class RoundedMenu {
        -_radius: int
        -_apply_mask()
    }
}

package "Lazy Directory Tree" {
    class LazyDirectoryTreeWidget {
        -_base_path: Path | None
        -_ignore_hidden: bool
        -_file_model: QFileSystemModel
        -_proxy_model: HighlightProxyModel
        +fileDoubleClicked: pyqtSignal(Path)
        +directoryChanged: pyqtSignal(Path)
        --
        +load_directory(path, highlight_files, color, compiled_rules)
        +set_highlight_group(name, paths, color)
        +clear_highlights()
        +remove_highlight_group(name)
        +set_ignore_hidden(bool)
        +resolve_item_path(index): Path | None
        +get_relative_path(index): Path | None
        +is_file(index): bool
        +set_header_label(label)
        +set_header_alignment(alignment)
        +clear()
        +base_path: Path | None <<property>>
        -_apply_filters()
        -_on_double_clicked(index)
    }

    class HighlightProxyModel <<proxy>> {
        -_base_path: Path | None
        -_highlight_groups: dict[str, set[str]]
        -_highlight_colors: dict[str, QColor]
        -_background_alpha: int = 50
        -_compiled_rules: list[CompiledRegexRule]
        -_header_label: str | None
        --
        +set_base_path(base_path)
        +set_highlight_group(name, paths, color)
        +clear_highlights()
        +remove_highlight_group(name)
        +set_compiled_rules(rules)
        +set_header_label(label)
        +data(index, role): foreground/background
        +headerData(section, orientation, role)
        +filterAcceptsRow(): regex filtering
        -_get_relative_path(index): str | None
    }

    note bottom of LazyDirectoryTreeWidget
      Explicit header APIs
      (`set_header_label`,
      `set_header_alignment`)
      replace legacy compatibility
      wrappers. Retired modules
      `ui/directory_tree_widget.py`
      and `ui/styles.py` are
      placeholders only.
    end note
}

package "Dialogs" {
    class SettingsDialog {
        -settings_manager: SettingsManager
        -applied_settings: AppSettings | None
        -validation_errors: list[str]
        --
        -_build_ui()
        -_load_settings(settings)
        -_update_validation()
    }

    class HelpDialog {
        +setup_ui()
    }

    class AboutDialog {
        +setup_ui()
        -_build_html(): str
    }

    class ReportDialog {
        -_processed_count: int
        --
        +setup_ui()
        +update_stats(SyncStats)
        +apply_styles()
    }
}

package "Theme System" {
    class ThemeManager <<singleton>> {
        {static} -_instance: ThemeManager
        -_provider: ThemeProvider
        -_current_theme: str
        -_stylesheet_cache: dict
        -_palette_cache: dict
        -_registered_widgets: WeakSet
        -_animations: WeakKeyDictionary
        --
        {static} +instance(): ThemeManager
        +set_provider(provider)
        +register(widget, role, animate)
        +apply_theme(theme, animate)
        +set_transition_duration(ms)
        -_apply_to_widget(widget, animate)
        -_animate_widget(widget)
    }

    interface ThemeProvider <<Protocol>> {
        +build_stylesheet(theme): str
        +build_palette(theme): QPalette
    }

    class AppThemeProvider {
        +build_stylesheet(theme): str
        +build_palette(theme): QPalette
    }
}

package "Async Workers" {
    class CompareWorkerThread <<thread>> {
        +finished: pyqtSignal(tuple)
        +progress: pyqtSignal(str)
        --
        +run()
    }
    class SyncWorkerThread <<thread>> {
        +finished: pyqtSignal(dict)
        +progress: pyqtSignal(str)
        +stats_updated: pyqtSignal(object)
        --
        +run()
    }
    class CancelWorkerThread <<thread>> {
        +finished: pyqtSignal(list)
        +progress: pyqtSignal(str)
        --
        +run()
    }
}

' === Inheritance ===
MainWindow --|> QMainWindow
LazyDirectoryTreeWidget --|> QTreeView
HighlightProxyModel --|> QSortFilterProxyModel
SettingsDialog --|> QDialog
HelpDialog --|> QDialog
AboutDialog --|> QDialog
ReportDialog --|> QDialog
CompareWorkerThread --|> QThread
SyncWorkerThread --|> QThread
CancelWorkerThread --|> QThread
AppThemeProvider ..|> ThemeProvider

' === Composition ===
MainWindow *-- LazyDirectoryTreeWidget : tree1, tree2
MainWindow *-- CompareWorkerThread
MainWindow *-- SyncWorkerThread
MainWindow *-- CancelWorkerThread
MainWindow *-- ClickableLineEdit : dir1/dir2 path
MainWindow *-- RoundedMenu

LazyDirectoryTreeWidget *-- HighlightProxyModel
LazyDirectoryTreeWidget *-- QFileSystemModel

' === Usage ===
MainWindow ..> SettingsDialog : opens
MainWindow ..> HelpDialog : opens
MainWindow ..> AboutDialog : opens
MainWindow ..> ReportDialog : opens (live stats)
MainWindow ..> ThemeManager : register + apply_theme

ThemeManager --> ThemeProvider : delegates styling
ThemeManager ..> MainWindow : styles via WeakSet
ThemeManager ..> SettingsDialog : styles
ThemeManager ..> HelpDialog : styles
ThemeManager ..> AboutDialog : styles
ThemeManager ..> ReportDialog : styles

note right of ThemeManager
  **Singleton** with animated
  theme transitions.
  Uses **WeakSet** to track
  widgets without memory leaks.
  Caches stylesheets & palettes.
  Themes: dark, light, **dracula**.
end note

note right of LazyDirectoryTreeWidget
  **Lazy loading** via
  QFileSystemModel — no UI
  freeze on large directories.
  Regex filtering via proxy.
  Header text/alignment via
  explicit widget APIs.
end note

@enduml
