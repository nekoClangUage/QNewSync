title Compareror — Settings & Configuration System\n(current state)

package "Configuration Domain" {
    class AppSettings {
        +theme: str = "dark"
        +ignore_hidden: bool = True
        +copy_empty_dirs: bool = False
        +diff_mode: str = "two-phase"
        +regex_rules: list[RegexRule]
    }

    class RegexRule <<frozen>> {
        +action: str
        +pattern: str
    }

    class CompiledRegexRule <<frozen>> {
        +action: str
        +pattern: str
        +regex: Pattern[str]
    }

    note top of AppSettings
      Valid themes: dark, light, **dracula**
      Valid diff modes: strict,
      two-phase, fast
    end note
}

package "Persistence Logic" {
    class SettingsManager <<logic>> {
        +settings_path: Path
        --
        +load(): tuple[AppSettings, list[str]]
        +save(settings): void
        +load_from_path(path): tuple[AppSettings, list[str]]
        +save_to_path(settings, path): void
    }

    class "settings_from_dict()" as FromDict <<logic>>
    class "settings_to_dict()" as ToDict <<logic>>
}

package "Validation & Compilation" {
    class "validate_regex_pattern()" as Validators <<logic>> {
        Checks for:
        - Empty patterns
        - Lookbehind assertions
        - Nested quantifiers
        - Invalid regex syntax
    }

    class "compile_regex_rules()" as Compiler <<logic>> {
        Validates + compiles
        list[RegexRule] →
        list[CompiledRegexRule]
    }

    class "should_include_path()" as Filter <<logic>> {
        1. Exclude rules first
        2. Include whitelist (if any)
        3. Default: allow
    }

    class "_detect_nested_quantifiers()" as NestedQ <<logic>> {
        Stack-based parser
        for (a+)+ patterns
    }
}

package "Storage" {
    object "settings.yaml" as YAML {
        theme: dark
        ignore_hidden: true
        copy_empty_dirs: false
        diff_mode: two-phase
        regex_rules:
          - action: exclude
            pattern: '.*\.tmp$'
    }
}

' Relationships
SettingsManager --> YAML : reads / writes
SettingsManager --> FromDict : uses on load
SettingsManager --> ToDict : uses on save
FromDict --> AppSettings : creates
ToDict --> AppSettings : serializes

AppSettings *-- RegexRule : contains 0..*

Compiler --> RegexRule : reads
Compiler --> CompiledRegexRule : produces
Compiler --> Validators : validates each pattern
Validators --> NestedQ : delegates detection

Filter --> CompiledRegexRule : evaluates against path

note right of Validators
  **Security Critical:**
  Prevents ReDoS attacks by
  detecting nested quantifiers
  like (a+)+ and blocking
  lookbehind assertions (?<=).
end note

note bottom of Filter
  **Evaluation order:**
  1. Exclude rules → reject on match
  2. Include rules → accept on match
  3. No include rules → allow all
end note

@enduml
